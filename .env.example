# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Database URL (e.g. Supabase, Neon.tech, or local PostgreSQL)
POSTGRES_URL="postgres://postgres:postgres@localhost:5432/quizlet_clone"

# -----------------------------------------------------------------------------
# NEXT-AUTH CONFIGURATION
# -----------------------------------------------------------------------------
# Generate via 'openssl rand -base64 32' or use a random string
AUTH_SECRET="supersecret-at-least-32-characters-long-please"

# Google OAuth Provider
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth Provider
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# Facebook OAuth Provider
AUTH_FACEBOOK_ID="your-facebook-client-id"
AUTH_FACEBOOK_SECRET="your-facebook-client-secret"

# Email sender address
AUTH_EMAIL_FROM="no-reply@example.com"

# -----------------------------------------------------------------------------
# S3 STORAGE CONFIGURATION (For uploading flashcard images)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_S3_REGION="ap-southeast-1"
NEXT_PUBLIC_S3_ACCESS_KEY="your-s3-access-key"
NEXT_PUBLIC_S3_SECRET_KEY="your-s3-secret-key"
NEXT_PUBLIC_S3_BUCKET_NAME="your-s3-bucket-name"